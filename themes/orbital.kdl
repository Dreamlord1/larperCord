// orbital — console de bordo: grafite esverdeado, tipografia técnica e uma
// faixa de servidores no rodapé. A identidade vem do sistema de numeração,
// do composer de comando e da barra superior com o wordmark, não de neon.
theme "orbital" description="Console de bordo: grafite, menta, numeração de sistemas e servidores no rodapé." description-en="Ship console: graphite, mint, system numbering and servers in the bottom strip." author="larperCord" preview=glass

options {
    option "telemetria" label="Telemetria no topo" description="Conexão, ping, RAM e relógio na barra superior." label-en="Top telemetry" description-en="Connection, ping, RAM and clock in the top bar." default=#true
    option "abas" label="Abas de canal" description="Canais abertos em abas acima da conversa." label-en="Channel tabs" description-en="Open channels as tabs above the conversation." default=#true
    option "topo" label="Barra de busca" description="Mostra a barra de busca e ajuda abaixo do wordmark (Ctrl+K continua funcionando)." label-en="Search bar" description-en="Shows the search/help bar below the wordmark (Ctrl+K still works)." default=#false
    option "crt" label="Scanlines do console" description="Um leve efeito de tela de nave por cima de tudo." label-en="Console scanlines" description-en="A subtle ship-screen effect over everything." default=#false
}

colors mode=dark {
    bg          "#070c0b"
    rail        "#0a1110"
    sidebar     "#0c1513"
    surface     "#101917"
    elevated    "#182320"
    overlay     "#0c1513"
    text        "#e9e7df"
    muted       "#969b94"
    faint       "#58615c"
    accent      "#75e0be"
    accent-text "#04130e"
    border      "#26312e"
    hover       "alpha(#75e0be, 0.06)"
    selected    "alpha(#75e0be, 0.14)"
    online      "#75e0be"
    idle        "#e6c46a"
    dnd         "#ff7b8a"
    danger      "#ff7b8a"
    mention     "#ffb38a"
    link        "#93c5ff"
    code-bg     "#0b1311"
    bubble-self "alpha(#75e0be, 0.12)"
    bubble-self-text "#dff8ef"
    bubble-other "#141f1c"
    shadow      "alpha(black, 0.50)"
}
roles mode=dark "#75e0be" "#93c5ff" "#b8a6d9" "#e6c46a" "#ff9a9a" "#a9c98a" "#7fd6e8" "#e9e7df"

colors mode=light {
    bg          "#f2f1ea"
    rail        "#e7e5dc"
    sidebar     "#eeece4"
    surface     "#fbfaf5"
    elevated    "#ffffff"
    overlay     "#ffffff"
    text        "#141a17"
    muted       "#5e6a64"
    faint       "#98a39d"
    accent      "#0f7a66"
    accent-text "#ffffff"
    border      "#d3d5cc"
    hover       "alpha(#0f7a66, 0.06)"
    selected    "alpha(#0f7a66, 0.12)"
    online      "#0f7a66"
    idle        "#8a6a00"
    dnd         "#b3264a"
    danger      "#b3264a"
    mention     "#b3562e"
    link        "#1f5f8f"
    code-bg     "#e6e5dc"
    bubble-self "alpha(#0f7a66, 0.10)"
    bubble-self-text "#062a22"
    bubble-other "#eef0e8"
    shadow      "alpha(black, 0.10)"
}
roles mode=light "#0f7a66" "#1f5f8f" "#6b4f9e" "#8a6a00" "#a33a4a" "#3f7a4a" "#2f6e7a" "#3a4a50"

fonts ui="Inter Display" mono="Monaspace Argon" size=14
metrics radius=8

styles {
    style "panel" bg="@surface" radius=8 border="@border" border-width=1
}

layout {
    stack {
        column {
            row height=36 bg=rail padding-x=16 gap=12 {
                label width=20 text="◉" size=12 color=accent align=center font=mono
                label flex=1 text="O R B I T A L" size=11 weight=semibold color=text
                status-bar flex=1 variant=plain bg=rail when=telemetria items="conn ping ram spacer clock"
            }
            row height=1 bg="alpha(@accent, 0.42)"
            topbar height=32 bg=rail when=topo
            row flex=1 padding=10 gap=10 {
                column width=260 style=panel {
                    row height=36 {
                        label width=34 text="01" size=18 weight=semibold color=accent align=center font=mono
                        label flex=1 text="CANAIS" size=9 weight=semibold color=muted font=mono
                    }
                    row height=1 bg="@border"
                    channel-list flex=1 variant=discord inset-x=4 font=mono
                    user-panel height=52 variant=tty inset-x=4
                }
                column flex=1 style=panel {
                    row height=36 {
                        label width=34 text="02" size=18 weight=semibold color=accent align=center font=mono
                        label flex=1 text="CANAL" size=9 weight=semibold color=muted font=mono
                    }
                    row height=1 bg="@border"
                    header height=44 variant=minimal inset-x=18
                    tabs height=40 variant=underline when=abas font=mono
                    messages flex=1 variant=cozy avatar=square avatar-size=26 spacing=12
                    column height=84 padding-x=18 {
                        spacer flex=1
                        composer height=44 variant=prompt
                        spacer height=14
                    }
                }
                column width=220 style=panel hide-below=1120 {
                    row height=36 {
                        label width=34 text="03" size=18 weight=semibold color=accent align=center font=mono
                        label flex=1 text="TRIPULAÇÃO" size=9 weight=semibold color=muted font=mono
                    }
                    row height=1 bg="@border"
                    member-list flex=1 variant=tty inset-y=4 font=mono
                }
            }
            row height=1 bg="alpha(@accent, 0.42)"
            row height=58 bg=rail padding-x=16 gap=14 {
                label width=34 text="04" size=18 weight=semibold color=accent align=center font=mono
                label width=94 text="SERVIDORES" size=9 weight=semibold color=muted font=mono
                guild-bar flex=1 orientation=horizontal variant=bar shape=squircle size=28 icon-style=outline labels=#false indicators=#false
                label width=72 text="DECK 07" size=9 weight=semibold color=muted align=right font=mono
            }
        }
        crt when=crt spacing=3 strength=0.04
    }
}
