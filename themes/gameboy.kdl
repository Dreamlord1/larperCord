// gameboy — o portátil de 1989: corpo cinza, moldura escura e a tela de LCD
// em quatro tons de verde. As cores mudam por pedaço do layout (c-…).
theme "gameboy" description="O portátil de 1989: corpo cinza, moldura escura e tela de LCD verde." author="larperCord" preview=gameboy

colors {
    bg          "#c7c6bd"
    rail        "#55556a"
    sidebar     "#9bbc0f"
    surface     "#9bbc0f"
    elevated    "#8bac0f"
    overlay     "#9bbc0f"
    text        "#2b2b38"
    muted       "#5d5d6e"
    faint       "#85858f"
    accent      "#8b1d58"
    accent-text "#f2f2ec"
    border      "#0f380f"
    hover       "alpha(#306230, 0.25)"
    selected    "alpha(#0f380f, 0.22)"
    online      "#0f380f"
    idle        "#306230"
    dnd         "#0f380f"
    danger      "#8b1d58"
    mention     "#0f380f"
    link        "#2d2f8f"
    code-bg     "#8bac0f"
    bubble-self "#306230"
    bubble-self-text "#9bbc0f"
    bubble-other "#8bac0f"
    shadow      "alpha(black, 0.18)"
}
roles "#0f380f" "#306230" "#0f380f" "#306230" "#0f380f" "#306230" "#0f380f" "#306230"

fonts ui="JetBrains Mono" mono="JetBrains Mono" size=14
metrics radius=0

styles {
    style "bezel" bg="@rail" radius=12 shadow=6
}

layout {
    column padding=18 gap=10 {
        column flex=1 padding=14 gap=8 style=bezel c-text="#a9a9b8" c-muted="#8a8a9c" {
            label height=18 text="•  DOT MATRIX WITH STEREO SOUND  •" size=11 weight=bold color=text align=center
            row flex=1 gap=0 bg=surface c-text="#0f380f" c-muted="#306230" c-faint="#306230" c-accent="#0f380f" c-accent-text="#9bbc0f" c-border="#306230" c-link="#0f380f" c-danger="#0f380f" {
                channel-list width=224 variant=tree inset-x=4 inset-y=4
                column flex=1 {
                    header height=30 variant=tty inset-x=4
                    messages flex=1 variant=irc avatar=none inset-x=4
                    spacer height=22
                    composer height=34 variant=prompt inset-x=4
                }
            }
        }
        row height=34 gap=12 {
            label width=160 text="larperCord" size=20 weight=bold color=link
            guild-bar flex=1 shape=text
        }
        status-bar height=22 variant=tty items="conn theme ram spacer keys clock"
    }
}
