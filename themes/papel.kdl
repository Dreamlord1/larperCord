// papel — um caderno: página cor de papel, tinta escura, títulos em serifa
// e o "Índice" (servidores + canais) na margem direita, como num livro.
theme "papel" description="Um caderno: página clara, títulos em serifa e o índice na margem." author="larperCord" preview=mirror

colors {
    bg          "#efe8da"
    rail        "#e4dac5"
    sidebar     "#ebe3d2"
    surface     "#f8f4ea"
    elevated    "#ebe3d2"
    overlay     "#fbf8f1"
    text        "#29231e"
    muted       "#6d6357"
    faint       "#a29785"
    accent      "#b23a2a"
    accent-text "#fbf8f1"
    border      "#dcd2bf"
    hover       "alpha(#29231e, 0.05)"
    selected    "alpha(#b23a2a, 0.11)"
    online      "#4d7a35"
    idle        "#b8860b"
    dnd         "#b23a2a"
    danger      "#b23a2a"
    mention     "#b23a2a"
    link        "#2f5d8c"
    code-bg     "#ece3cf"
    bubble-self "#b23a2a"
    bubble-other "#ebe3d2"
    shadow      "alpha(#5a4320, 0.14)"
}
// Cores de tinta: nada de arco-íris.
roles "#8c3b2a" "#2f5d8c" "#4d6b35" "#6d4b7d" "#94701f" "#2f6e6e" "#8a4060" "#5b4a3a"

fonts ui="Inter" mono="JetBrains Mono" size=16
metrics radius=4

layout {
    row {
        column flex=1 bg=surface {
            header height=86 variant=minimal inset-x=44 font="Liberation Serif"
            messages flex=1 avatar=none spacing=22 inset-x=28
            column height=96 padding-x=44 {
                spacer flex=1
                composer height=46
                spacer height=24
            }
        }
        column width=272 bg=sidebar {
            label height=68 text="Índice" font="Liberation Serif" size=24 weight=bold color=text
            guild-bar height=206 variant=list shape=circle size=22 icon-style=soft
            channel-list flex=1 header=#false
            user-panel height=56
        }
    }
}
