// classico — o layout que todo mundo conhece, nas cores do seu pywal.
// Exclusivo: banner do servidor no topo da lista de canais.
theme "classico" description="O layout familiar, nas cores do seu wallpaper, com banner do servidor." author="larperCord" preview=classic
palette "wal"

options {
    option "banner" label="Banner do servidor" description="Faixa colorida com o nome do servidor no topo dos canais." default=#true
}

fonts ui="Inter" mono="JetBrains Mono" size=16
metrics radius=6

styles {
    style "panel" bg="mix(@sidebar, @rail, 0.5)"
}

layout {
    row {
        guild-bar width=72 bg=rail
        column width=240 bg=sidebar {
            channel-list flex=1 banner="$banner"
            user-panel height=52 style=panel
        }
        column flex=1 bg=bg {
            header height=48
            messages flex=1
            column height=92 padding-x=16 {
                spacer flex=1
                composer height=46
                spacer height=22
            }
        }
        member-list width=248 bg=sidebar hide-below=1040
    }
}
