// neon — synthwave contido: quase preto, cartões bem separados e só duas
// cores acesas (magenta e ciano). Os servidores ficam num dock que cresce
// perto do mouse, com ícones em contorno.
theme "neon" description="Synthwave: preto-roxo, magenta e ciano, e um dock que cresce no mouse." author="larperCord" preview=dock

colors {
    bg          "#07040f"
    rail        "#0e0820"
    sidebar     "#110a26"
    surface     "#120b2a"
    elevated    "#1c1240"
    overlay     "#170f36"
    text        "#efe7ff"
    muted       "#a497c9"
    faint       "#675a8f"
    accent      "#ff3cac"
    accent-text "#07040f"
    border      "alpha(#2de2e6, 0.16)"
    hover       "alpha(#2de2e6, 0.06)"
    selected    "alpha(#ff3cac, 0.16)"
    online      "#3ee6a0"
    idle        "#f9c80e"
    dnd         "#ff4f81"
    danger      "#ff4f81"
    mention     "#2de2e6"
    link        "#2de2e6"
    code-bg     "#1f1450"
    bubble-self "#ff3cac"
    bubble-self-text "#07040f"
    bubble-other "#1c1240"
    shadow      "alpha(#ff3cac, 0.22)"
}
roles "#ff6ec7" "#2de2e6" "#f9c80e" "#a77bff" "#3ee6a0" "#ff9a62" "#7aa7ff" "#ff4f81"

fonts ui="Inter" mono="JetBrains Mono" size=15
metrics radius=10

styles {
    style "card" bg="@surface" radius=16 border="@border" glow="alpha(#ff3cac, 0.8)" border-width=1.5 shadow=18
}

layout {
    column padding=16 gap=10 {
        row flex=1 gap=14 {
            channel-list width=244 style=card inset-y=4
            column flex=1 style=card {
                tabs height=44 variant=underline
                header height=46 divider=#false
                messages flex=1 avatar=squircle
                column height=92 padding-x=16 {
                    spacer flex=1
                    composer height=48 variant=pill
                    spacer height=16
                }
            }
            member-list width=224 style=card hide-below=1150 inset-y=4
        }
        guild-bar height=82 variant=dock shape=squircle size=40 icon-style=outline
    }
}
